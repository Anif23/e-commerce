# ---- Server ----
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# ---- Database ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce_test?schema=public"

# ---- Auth ----
JWT_SECRET=change-me-access
REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# ---- Payments -------------------------------------------------------------
# auto   -> use a gateway when its keys are present, otherwise the simulator
# live   -> real gateways only (PayPal / Stripe)
# mock   -> force the simulator (handy for local demos and CI)
PAYMENT_MODE=auto
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_WINDOW_MINUTES=15

# ---- Money / fulfilment defaults (Asnif Store trades in India) ----
# Amounts are in Indian rupees (INR) and the tax rate is GST in percent.
STORE_CURRENCY=INR
DEFAULT_SHIPPING_FEE=49
FREE_SHIPPING_THRESHOLD=999
TAX_RATE_PERCENT=18

# ---- Uploads & seed ----
UPLOAD_DIR=uploads
SEED_ADMIN_EMAIL=admin@store.dev
SEED_ADMIN_PASSWORD=Admin@123
SEED_USER_EMAIL=shopper@store.dev
SEED_USER_PASSWORD=Shopper@123
