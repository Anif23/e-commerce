# Frontend environment — copy to `.env` and adjust.

# Leave unset to use the Vite dev-server proxy (`/api` -> http://127.0.0.1:5000).
# Set it only when the API is served from a different origin.
VITE_API_URL=/api

# PayPal sandbox/live client id for the smart payment buttons.
# Without it PayPal is skipped and the mock gateway is offered instead.
VITE_PAYPAL_CLIENT_ID=
# Charge currency for PayPal (keep in sync with STORE_CURRENCY on the API)
VITE_PAYPAL_CURRENCY=INR

# Public Stripe publishable key (optional — enables the Stripe element flow).
VITE_STRIPE_PUBLIC_KEY=

# Change when the API runs somewhere other than 127.0.0.1:5000.
VITE_PROXY_TARGET=http://127.0.0.1:5000
